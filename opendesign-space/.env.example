[TEMPLATE]
# ============================================================
# OpenDesign × HF Spaces — environment reference
# Copy the keys you need into your HF Space secrets/variables.
# Never commit real secret VALUES to a repository.
# start.sh fixes OD_PORT/OD_BIND_HOST/OD_DATA_DIR for the Space;
# only set them locally if you know why.
# ============================================================

# ── Auth ──
# OD_API_TOKEN: login PASSWORD for the UI + API (mandatory on 0.0.0.0).
# GATEWAY_TOKEN is accepted as an alias. Generate: openssl rand -hex 32
OD_API_TOKEN=
GATEWAY_TOKEN=
# OD_API_USERNAME: login USERNAME (Basic auth). Default: open-design
OD_API_USERNAME=

# ── Persistence ──
# HF_TOKEN: HF token with WRITE scope; enables dataset backup/restore.
HF_TOKEN=
# Private dataset repo name (default: opendesign-backup)
BACKUP_DATASET_NAME=
# Sync cadence in seconds (default: 600)
SYNC_INTERVAL=
# Per-file upload cap in bytes (default: 52428800 = 50MB)
SYNC_MAX_FILE_BYTES=

# ── CORS ──
# Auto-derived from SPACE_HOST; add origins only for custom domains.
OD_EXTRA_ORIGINS=

# ── Advanced ──
# Responses-API routing extras (comma-separated model regexes) — muse-spark*
# is always routed; add more ONLY if Zen serves them on /v1/responses.
# OD_RESPONSES_API_MODELS=
# OD_RESPONSES_API_ALL=1 forces ALL models through /responses (rarely wanted).
# Reasoning effort for muse models on ALL paths (default high; accepts low,
# medium, high, xhigh, or 'default' for the server default). Deepen or speed
# up thinking without touching other models.
# OD_MUSE_REASONING_EFFORT=
# Bash snippet replayed on every boot (after restore, before launch).
OD_SPACE_RUN=
# Settings "Test connection" timeout in ms (default 12000; reasoning models
# like muse-spark / big-pickle need more — start.sh defaults this to 30000).
OD_CONNECTION_TEST_PROVIDER_TIMEOUT_MS=
# Supervisor tuning (defaults: 5s delay, unlimited restarts)
OD_RESTART_DELAY=
OD_MAX_RESTARTS=
# Node heap (default 2048MB on HF free CPU basic)
NODE_OPTIONS=
